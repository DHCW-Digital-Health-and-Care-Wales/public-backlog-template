{
  "name": "public-backlog-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A DHCW template for publishing a public, bilingual, accessible product backlog from GitHub Issues.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build:data": "tsx scripts/build-snapshot.ts",
    "build:data:fixture": "tsx scripts/build-snapshot.ts --fixture",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "tsx scripts/prerender.ts",
    "build": "npm run build:data:fixture && tsc --noEmit && npm run build:client && npm run build:server && npm run prerender",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "preact": "^10.29.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@fontsource/roboto": "^5.1.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.49.1",
    "@preact/preset-vite": "^2.10.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "preact-render-to-string": "^6.7.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.6",
    "yaml": "^2.7.0"
  }
}
