{
  "name": "public-backlog-template",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:data": "tsx scripts/build-snapshot.ts",
    "build:data:fixture": "tsx scripts/build-snapshot.ts --fixture",
    "dev": "vite",
    "build": "npm run build:data:fixture && tsc -b && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@lhci/cli": "0.14.0",
    "@playwright/test": "1.49.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8",
    "yaml": "2.6.1"
  }
}
